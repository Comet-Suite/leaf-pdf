{
  "manifest_version": 3,
  "name": "Leaf PDF Viewer",
  "version": "1.0.0",
  "description": "Replaces Chrome's built-in PDF viewer with Leaf PDF - annotate, sign, highlight, redact, protect and screenshot PDFs.",
  "permissions": ["declarativeNetRequest", "tabs", "webRequest", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
